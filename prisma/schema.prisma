// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USERS & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  phone         String?
  country       String?
  emailVerified DateTime?
  image         String?
  
  // Authentication
  password      String?   // For email/password auth, null for OAuth
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  downloads     Download[]
  
  // Metadata
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@map("users")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// PRODUCTS & CATALOG
// ============================================

model Category {
  id              String    @id @default(cuid())
  nameAr          String    @unique
  slugAr          String    @unique
  descriptionAr   String?
  image           String?
  displayOrder    Int       @default(0)
  
  // Relations
  products        Product[]
  
  // Metadata
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([slugAr])
  @@map("categories")
}

model Product {
  id              String    @id @default(cuid())
  nameAr          String
  slugAr          String    @unique
  subtitleAr      String?
  descriptionAr   String
  descriptionLong String?   @db.Text
  
  // Pricing
  price           Int       // Store in cents (999 = $9.99)
  originalPrice   Int?      // For discounts
  discountPercent Int?      // Discount percentage
  
  // Category
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  
  // Product attributes
  coverImage      String
  featured        Boolean   @default(false)
  bestSeller      Boolean   @default(false)
  status          String    @default("active") // active, draft, archived
  
  // SEO
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?
  
  // Additional metadata (flexible JSON storage)
  metadata        Json      @default("{}")
  
  // Relations
  orderItems      OrderItem[]
  downloads       Download[]
  files           ProductFile[]
  faqs            ProductFAQ[]
  images          ProductImage[]
  learnings       ProductLearning[]
  inclusions      ProductInclusion[]
  
  // Metadata
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@index([bestSeller])
  @@index([slugAr])
  @@map("products")
}

model ProductFile {
  id              String    @id @default(cuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  fileName        String
  fileSize        Int       // bytes
  storageUrl      String    // S3/Supabase URL
  fileType        String    // pdf, epub, zip, etc.
  displayOrder    Int       @default(0)
  
  createdAt       DateTime  @default(now())
  
  @@index([productId])
  @@map("product_files")
}

model ProductImage {
  id              String    @id @default(cuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  imageUrl        String
  imageType       String    @default("product") // product, preview, mockup
  displayOrder    Int       @default(0)
  
  createdAt       DateTime  @default(now())
  
  @@index([productId])
  @@map("product_images")
}

model ProductFAQ {
  id              String    @id @default(cuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  questionAr      String
  answerAr        String    @db.Text
  displayOrder    Int       @default(0)
  
  @@index([productId])
  @@map("product_faqs")
}

model ProductLearning {
  id              String    @id @default(cuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  textAr          String
  displayOrder    Int       @default(0)
  
  @@index([productId])
  @@map("product_learnings")
}

model ProductInclusion {
  id              String    @id @default(cuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  textAr          String
  displayOrder    Int       @default(0)
  
  @@index([productId])
  @@map("product_inclusions")
}

// ============================================
// SHOPPING & ORDERS
// ============================================

model Order {
  id              String    @id @default(cuid())
  orderNumber     String    @unique // Human-readable order number
  
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  
  // Order details
  totalPrice      Int       // cents
  currency        String    @default("USD")
  status          String    @default("pending") // pending, paid, delivered, refunded, cancelled
  
  // Customer info
  email           String
  phone           String?
  
  // Coupon/Discount
  couponId        String?
  coupon          Coupon?   @relation(fields: [couponId], references: [id])
  discountAmount  Int?
  
  // Items & Payment
  items           OrderItem[]
  payment         Payment?
  downloads       Download[]
  
  // Timestamps
  createdAt       DateTime  @default(now())
  paidAt          DateTime?
  deliveredAt     DateTime?
  refundedAt      DateTime?
  updatedAt       DateTime  @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id              String    @id @default(cuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  
  // Price snapshot (audit trail)
  priceAtTime     Int       // cents at purchase
  quantity        Int       @default(1)
  
  createdAt       DateTime  @default(now())
  
  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id              String    @id @default(cuid())
  orderId         String    @unique
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Payment gateway info
  provider        String    @default("paytabs") // paytabs, stripe, etc.
  transactionId   String?   @unique
  amount          Int       // cents
  currency        String
  status          String    @default("pending") // pending, success, failed, refunded
  
  // Payment metadata (gateway responses, etc.)
  metadata        Json      @default("{}")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([orderId])
  @@map("payments")
}

model Download {
  id              String    @id @default(cuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  
  // Download tracking
  downloadToken   String    @unique
  tokenExpiresAt  DateTime  // Token expiration (typically 30 days)
  downloadCount   Int       @default(0)
  lastDownloadAt  DateTime?
  
  createdAt       DateTime  @default(now())
  
  @@index([orderId])
  @@index([productId])
  @@index([userId])
  @@map("downloads")
}

// ============================================
// PROMOTIONS
// ============================================

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  description     String?
  
  // Discount type
  discountType    String    @default("percentage") // percentage, fixed
  discountValue   Int       // e.g., 20 for 20% or 500 for $5
  
  // Restrictions
  maxUses         Int?      // Maximum total uses
  maxPerUser      Int?      // Maximum uses per customer
  minOrderAmount  Int?      // Minimum order amount in cents
  
  // Status
  active          Boolean   @default(true)
  validFrom       DateTime  @default(now())
  validUntil      DateTime?
  
  // Usage tracking
  usageCount      Int       @default(0)
  
  // Relations
  orders          Order[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@map("coupons")
}

// ============================================
// APPLICATION SETTINGS
// ============================================

model Settings {
  id              String    @id @default("singleton")
  
  // Company info
  companyName     String    @default("ATHAR")
  companyEmail    String    @default("info@athar.com"
  companyPhone    String?
  companyWebsite  String?
  
  // Payment settings (use environment variables, not stored plaintext)
  paymentProvider String    @default("paytabs")
  paymentMode     String    @default("mock") // mock, production
  
  // Store settings
  currency        String    @default("USD")
  currencySymbol  String    @default("$")
  languages       String[]  @default(["ar"])
  
  // Refund policy
  refundDays      Int       @default(30)
  refundPolicy    String?   @db.Text
  
  // Store status
  storeOpen       Boolean   @default(true)
  maintenanceMode Boolean   @default(false)
  maintenanceMessage String?
  
  // Social & Analytics (tracking IDs, not secrets)
  googleAnalytics String?
  metaPixel       String?
  tikTokPixel     String?
  
  updatedAt       DateTime  @updatedAt
  
  @@map("settings")
}
